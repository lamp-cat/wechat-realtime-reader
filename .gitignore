# Secrets — never commit
**/keys*.json
**/image-key*.json
**/source-config.json
!**/source-config.json.template
**/gateway-token
**/web-token
**/ai-config.json
**/key-capture/
**/.secrets/
**/candidates-*.jsonl
**/keys-new-*.json

# Python / venv
**/.venv/
**/__pycache__/
*.py[cod]

# Runtime state, snapshots, databases, logs
**/state/
**/snapshots/
**/decrypted/
**/exports/
**/manifests/
*.db
*.db-*
*.sqlite*
*.wal
*.shm
*.journal
*.log

# Backups / OS cruft
*.bak
*.bak-*
.DS_Store
._*
Thumbs.db

# Frida binaries are fetched/verified at build/setup time, not committed
**/vendor/frida/frida-inject-*
**/vendor/frida/*.part
**/vendor/frida/*.tmp
